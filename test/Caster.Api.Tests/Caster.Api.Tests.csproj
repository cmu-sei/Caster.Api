<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- As in Caster.Api: implicit usings and nullable reference types are both off. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Required by xUnit v3: the test project is a self-executing host. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>Caster.Api.Tests</RootNamespace>

    <!--
      Microsoft.Testing.Platform (global.json test.runner): the test project runs as its own test app, under
      `dotnet test` and `dotnet run` alike. xunit.v3 4 and later only run this way on the .NET 10 SDK.
    -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="NSubstitute" />
    <!-- The shared harness in Support/Shared (agent-docs/api-testing). -->
    <Using Include="Crucible.Api.Testing" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Terraform state, plan and GitLab fixtures read by the pure unit tests. -->
    <None Update="Data/terraform.tfstate" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Data/plan.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Data/topology/*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Data/gitlab-modules.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Real Terraform module declarations copied from the Crucible module
         catalog, used as the module source fixture. Hand-written JSON would not
         exercise the loader's object-form / omitted-default constraints. -->
    <Content Include="Data/catalog/**/*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    caster.api has no central package management (no Directory.Packages.props), so the versions pinned by
    agent-docs/api-testing/test-packages.props are written here.
  -->
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.3" />
    <PackageReference Include="coverlet.MTP" Version="10.1.0" />
    <PackageReference Include="NSubstitute" Version="6.2.0" />
    <!-- Hosts the API in process over TestServer, so the tests drive the real Startup. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <!-- The client for ProjectHub's real-connection tests (Hubs/ProjectHubConnectionTests.cs). -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Caster.Api\Caster.Api.csproj" />
  </ItemGroup>

</Project>
