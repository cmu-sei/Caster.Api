<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- As in Caster.Api: implicit usings and nullable reference types are both off. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Required by xUnit v3: the test project is a self-executing host. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>Caster.Api.Tests</RootNamespace>

    <!--
      Applies coverlet.runsettings to every run, so a coverage run cannot go without its exclusions. The
      collector in that file is disabled by default, so an ordinary `dotnet test` collects nothing.
    -->
    <RunSettingsFilePath>$(MSBuildProjectDirectory)/coverlet.runsettings</RunSettingsFilePath>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="NSubstitute" />
    <!-- The shared harness in Support/Shared (agent-docs/api-testing). -->
    <Using Include="Crucible.Api.Testing" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Terraform state, plan and GitLab fixtures read by the pure unit tests. -->
    <None Update="Data/terraform.tfstate" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Data/plan.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Data/gitlab-modules.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    caster.api has no central package management (no Directory.Packages.props), so the versions pinned by
    agent-docs/api-testing/test-packages.props are written here.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="NSubstitute" Version="6.0.0" />
    <!-- Hosts the API in process over TestServer, so the tests drive the real Startup. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.1" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.15.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Caster.Api\Caster.Api.csproj" />
  </ItemGroup>

</Project>
