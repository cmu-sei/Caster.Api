{
  "PathBase": "",
  "Logging": {
    "LogLevel": {
      "Default": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PostgreSQL": "Server=localhost;Port=5432;Database=caster_api;Username=;Password=;"
  },
  "Authorization": {
    "Authority": "http://localhost:5000",
    "AuthorizationUrl": "http://localhost:5000/connect/authorize",
    "TokenUrl": "http://localhost:5000/connect/token",
    "AuthorizationScope": "caster",
    "ClientId": "caster-api",
    "ClientName": "Caster API",
    "ClientSecret": "",
    "RequireHttpsMetaData": false,
    "ValidateAudience": true,
    "ValidAudiences": [] // Defaults to AuthorizationScope if null or empty
  },
  "ClaimsTransformation": {
    "EnableCaching": true,
    "CacheExpirationSeconds": 60,
    "UseRolesFromIdP": true,
    "RolesClaimPath": "realm_access.roles",
    "UseGroupsFromIdP": true,
    "GroupsClaimPath": "groups"
  },
  "Client": {
    "TokenUrl": "http://localhost:5000/connect/token",
    "ClientId": "caster-admin",
    "Scope": "player player-vm",
    "UserName": "",
    "Password": "",
    "MaxRetryDelaySeconds": 120,
    "TokenRefreshSeconds": 600
  },
  "CorsPolicy": {
    "Origins": ["http://localhost:4310"],
    "Methods": [],
    "Headers": [],
    "AllowAnyOrigin": false,
    "AllowAnyMethod": true,
    "AllowAnyHeader": true,
    "SupportsCredentials": true
  },
  "Player": {
    "VmApiUrl": "http://localhost:4302",
    "VmConsoleUrl": "http://localhost:4305/vm/{id}/console",
    "MaxParallelism": 8,
    "RemoveLoopSeconds": 300
  },
  "Terraform": {
    "BinaryPath": "",
    "DefaultVersion": "0.12.29",
    "PluginDirectory": "",
    "RootWorkingDirectory": "",
    "OutputSaveInterval": 5000,
    // Legacy Gitlab module source. Both GitlabApiUrl and GitlabGroupId must be
    // set for it to be used. Unchanged - existing deployments need no migration.
    "GitlabApiUrl": "",
    "GitlabToken": "",
    "GitlabGroupId": null,
    // Plain git module sources, read with git instead of a server API.
    // Versions come from tags; variables and outputs from variables.tf.json and
    // outputs.tf.json in each module root. https sources authenticate through
    // the git credential store (the chart's gitcredentials value); file:// and
    // public https need nothing.
    //   Name:        prefixes the Path of every Module found here. Required.
    //   Url:         clone url, used verbatim by git and in the generated
    //                source = "git::<Url>?ref=<tag>". Required.
    //   Provider:    "Git" (default).
    //   Layout:      "Root" (default) = the repo root is one module.
    //                "Subdirectories" = every immediate subdirectory holding a
    //                variables.tf.json or outputs.tf.json is its own module,
    //                addressed as "git::<Url>//<subdir>?ref=<tag>".
    //                A plain tag ("v1.0.0") versions every module; a tag
    //                "<subdir>/<version>" ("network-segment/v1.2.0") versions
    //                only that module, so modules can be released separately.
    "ModuleSources": [
      // {
      //   "Name": "crucible-modules",
      //   "Description": "Crucible vSphere module catalog",
      //   "Provider": "Git",
      //   "Url": "https://git.example.com/your-org/terraform-modules.git",
      //   "Layout": "Subdirectories"
      // }
    ],
    // Seconds any single git command may run before it is killed.
    "ModuleSourceTimeoutSeconds": 120,
    "StateRetryCount": 12,
    "StateRetryIntervalSeconds": 5,
    "AzureDestroyFailureThreshhold": 2,
    "MaxParallelism": 25,
    "SelectWorkspace": false,
    // Read each successful plan's machines and networks for the Topology view.
    // One extra "terraform show -json" per plan (one more pod in job mode).
    "GenerateTopology": true,
    // Resource types the Topology view draws besides the built-in Proxmox,
    // vSphere, AWS and Azure ones; an entry with a built-in name replaces it.
    // Attributes are paths into the resource's values, list indexes as numbers.
    // "Interfaces" are NICs that are resources of their own, which a machine
    // lists by id (as azurerm_network_interface is, built in).
    "Topology": {
      "Machines": {
        // "google_compute_instance": {
        //   "Nics": "network_interface",
        //   "Network": "subnetwork",
        //   "Properties": { "machine_type": "machine_type" }
        // }
      },
      "Networks": {
        // "google_compute_subnetwork": { "Keys": [ "self_link", "name" ] }
      },
      "Interfaces": {}
    },
    "MaxConcurrentRuns": 0,
    // Environment variables passed to every run. See docs/Runs.md.
    "EnvironmentVariables": {
      // Pass every API environment variable to every run, including the API's own
      // database connection string, OIDC client secret and GitLab token.
      // Leave false and list what runs need in Inherit.
      "InheritAll": false,
      "Inherit": [
        // "^SEI",
        // "^VSPHERE",
        // "^PROXMOX",
        // "^AWS",
        // "^ARM",
        // "^SSL_CERT_DIR"
      ],
      "Direct": {
        // "SSL_CERT_DIR": "/usr/local/share/ca-certificates/:/etc/ssl/certs/"
      }
    },
    // API environment variables that hold credentials. A variable whose name matches
    // one of these regexes never reaches a run through Inherit or InheritAll; admins
    // give it to projects through Environment Sets. See docs/EnvironmentSets.md.
    "Secrets": {
      "Patterns": ["^CASTER_SECRET_"]
    },
    "KubernetesJobs": {
      "Enabled": false,
      "UseHostVolume": false,
      "HostVolumePath": "/mnt/data/terraform",
      "Namespace": "default",
      "Context": "",
      "PersistentVolumeClaimName": "caster-terraform-data-pvc",
      "VolumeMountPath": "/terraform",
      "VolumeMountSubPath": "",
      "RootWorkingDirectory": "/terraform/root",
      "ImageRegistry": "https://registry-1.docker.io/", // docker hub
      "ImageName": "hashicorp/terraform",
      "ImageTags": ["1.14", "1.13", "0.12.29"],
      "QueryImageTags": true,
      "QueryImageTagsRegex": "^([0-9]\\d*\\.\\d+\\.\\d+)$", // all x.x.x semantic versions, no -beta or similar
      "QueryImageTagsMinutes": 720, // twice a day
      "ConfigMaps": [
        // {
        //   "Name": "caster-certs",
        //   "MountPath": "/usr/local/share/ca-certificates/",
        // },
        // {
        //   "Name": "terraformrc",
        //   "MountPath": "/app/.terraformrc",
        //   "SubPath": ".terraformrc"
        // }
      ],
      "JobTemplateFile": "", // Path to a V1Job YAML file to use as a template.
      "JobTemplateYaml": "", // Inline V1Job YAML string to use as a template.
      "PodReadyTimeoutSeconds": 120
    }
  },
  "FileVersions": {
    "DaysToSaveAllUntaggedVersions": 7,
    "DaysToSaveDailyUntaggedVersions": 31
  },
  // Discovery of the infrastructure Caster deploys to, used to populate pickers instead of
  // free-text fields. Off by default. See docs/Inventory.md.
  "Infrastructure": {
    // Each connection is read and cached on its own and inherits nothing from another.
    // Clients pick one with ?connection=<Name>; a request that names none uses the first
    // connection with inventory enabled. Connection settings never reach Terraform runs. e.g.
    // "Connections": [
    //   {
    //     // Required and unique, ignoring case. Other settings refer to a connection by its
    //     // Name, so renaming one breaks those references, which then show as missing.
    //     "Name": "lab-vcenter",
    //     "Provider": "vsphere", // "vsphere" or "proxmox"
    //     // vsphere: the vCenter base url, e.g. https://vcenter.example.com
    //     // proxmox: the PVE base url including the port, e.g. https://pve.example.com:8006
    //     //          ("/api2/json" is appended automatically, and the port is never guessed)
    //     "Url": "https://vcenter.example.com",
    //     // vsphere: required, with Password. Read over the SOAP (vim25) api, and the REST api
    //     //          for content libraries; the ISO list also needs Datastore > Browse datastore.
    //     // proxmox: only used when ApiToken is empty. The full user@realm, e.g. caster@pve
    //     "Username": "",
    //     "Password": "",
    //     // proxmox only, and preferred over Username/Password when set. One opaque string in
    //     // exactly the form Proxmox prints at token creation: "user@realm!tokenid=secret".
    //     "ApiToken": "",
    //     "InsecureSkipVerify": false, // set true only for a provider with an untrusted certificate
    //     // Where this connection's ISOs live; the ISO list shows only these.
    //     // proxmox: storage names, e.g. "iso-stock", or volid prefixes, e.g.
    //     //          "local:iso/00000000-0000-0000-0000-000000000000__" for TopoMojo's shared ISOs.
    //     //          Empty = every storage that holds ISOs.
    //     // vsphere: datastore names, e.g. "iso-datastore", or folders, e.g. "[iso-datastore] stock".
    //     //          Required: empty lists no ISOs and says so, since searching every datastore is
    //     //          slow and finds the ISOs inside VM folders too.
    //     "IsoLocations": [],
    //     // vsphere only: the datacenters to read, by name. Empty = all of them. Content
    //     // libraries belong to the whole vCenter, so this doesn't filter them.
    //     "Datacenters": [],
    //     "Inventory": {
    //       "Enabled": true,
    //       "RefreshMinutes": 30,
    //       // VmTemplates, Isos, Networks, Datastores, ContentLibraries and Hosts, each on by
    //       // default. Enabled: false skips reading that kind of object. Locations (not for Isos
    //       // or ContentLibraries) lists only objects in those places: for vsphere a full
    //       // inventory path such as "/DC1/vm/Templates", matching it and everything below it,
    //       // or for Networks a distributed switch's name; for proxmox a node, resource pool
    //       // (VmTemplates), SDN zone (Networks) or storage (Datastores). Include and Exclude
    //       // are regular expressions on the name, ignoring case; Exclude wins. A setting that
    //       // can't be used marks the connection as misconfigured, and it isn't read.
    //       "Resources": {
    //         // "ContentLibraries": { "Enabled": false },
    //         // "VmTemplates": { "Locations": [ "/DC1/vm/Templates" ], "Exclude": "-old$" },
    //         // "Networks": { "Include": "^lab-" }
    //       }
    //     }
    //   }
    // ]
    "Connections": []
  },
  "OpenTelemetry": {
    "AddAlwaysOnTracingSampler": false,
    "AddConsoleExporter": false,
    "AddPrometheusExporter": false,
    "IncludeDefaultActivitySources": true,
    "IncludeDefaultMeters": true
  },
